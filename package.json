{
  "name": "buscador-archivos",
  "version": "1.0.0",
  "description": "Aplicacion de escritorio moderna para busqueda inteligente de archivos PDF en red",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.irec.buscadorarchivos",
    "productName": "Buscador de Archivos IREC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.log"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Buscador de Archivos IREC"
    }
  },
  "keywords": [
    "electron",
    "pdf",
    "search",
    "files",
    "stellum"
  ],
  "author": "Stellum Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3"
  }
}
